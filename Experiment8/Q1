#include <stdio.h>

int main() {
    int n, i, j, temp;
    int arr[100];
    int comparisons = 0, swaps = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    for(i = 0; i < n - 1; i++) {
        for(j = 0; j < n - i - 1; j++) {
            comparisons++;
            if(arr[j] > arr[j + 1]) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
                swaps++;
            }
        }

        printf("After pass %d: ", i + 1);
        for(j = 0; j < n; j++)
            printf("%d ", arr[j]);
        printf("\n");
    }

    printf("Sorted Array: ");
    for(i = 0; i < n; i++)
        printf("%d ", arr[i]);

    printf("\nComparisons = %d", comparisons);
    printf("\nSwaps = %d", swaps);

    return 0;
}
