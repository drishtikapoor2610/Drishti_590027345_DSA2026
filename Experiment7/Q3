#include<stdio.h>

int main()
{
int n,e,i,j,u,v,vertex;
int graph[20][20]={0};
int indegree=0,outdegree=0;

printf("Enter number of vertices: ");
scanf("%d",&n);

printf("Enter number of edges: ");
scanf("%d",&e);

for(i=1;i<=e;i++)
{
printf("Enter edge (u v): ");
scanf("%d%d",&u,&v);

graph[u][v]=1;
}

printf("\nAdjacency Matrix:\n");

for(i=0;i<n;i++)
{
for(j=0;j<n;j++)
printf("%d ",graph[i][j]);

printf("\n");
}

printf("Enter vertex: ");
scanf("%d",&vertex);

for(i=0;i<n;i++)
{
if(graph[i][vertex]==1)
indegree++;

if(graph[vertex][i]==1)
outdegree++;
}

printf("In-Degree=%d",indegree);
printf("\nOut-Degree=%d",outdegree);

return 0;
}
