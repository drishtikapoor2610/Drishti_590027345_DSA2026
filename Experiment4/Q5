#include <stdio.h>

#define MAX 10

int q1[MAX], q2[MAX];
int front1 = -1, rear1 = -1;
int front2 = -1, rear2 = -1;

// Enqueue helper
void enqueue(int q[], int *front, int *rear, int val) {
    if (*rear == MAX - 1) return;
    if (*front == -1) *front = 0;
    q[++(*rear)] = val;
}

// Dequeue helper
int dequeue(int q[], int *front, int *rear) {
    if (*front == -1) return -1;
    int val = q[*front];
    (*front)++;
    if (*front > *rear) *front = *rear = -1;
    return val;
}

// Push
void push(int val) {
    enqueue(q2, &front2, &rear2, val);

    while (front1 != -1) {
        enqueue(q2, &front2, &rear2, dequeue(q1, &front1, &rear1));
    }

    // Swap q1 and q2
    int tempFront = front1, tempRear = rear1;
    front1 = front2; rear1 = rear2;
    front2 = tempFront; rear2 = tempRear;
}

// Pop
void pop() {
    if (front1 == -1)
        printf("Stack Empty\n");
    else
        printf("Popped: %d\n", dequeue(q1, &front1, &rear1));
}

// Peek
void peek() {
    if (front1 != -1)
        printf("Top: %d\n", q1[front1]);
}

// Display
void display() {
    for (int i = front1; i <= rear1; i++) {
        printf("%d ", q1[i]);
    }
    printf("\n");
}

int main() {
    push(10);
    push(20);
    push(30);
    display();
    pop();
    display();
    return 0;
}
