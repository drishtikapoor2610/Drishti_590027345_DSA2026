#include <stdio.h>
#include <string.h>

#define MAX 100

char queue[MAX];
int front = 0, rear = -1;

void enqueue(char c) {
    queue[++rear] = c;
}

char dequeue() {
    return queue[front++];
}

int main() {
    char str[MAX];
    printf("Enter string: ");
    scanf("%s", str);

    int n = strlen(str);

    for (int i = 0; i < n; i++) {
        enqueue(str[i]);
    }

    int isPalindrome = 1;

    for (int i = n - 1; i >= 0; i--) {
        if (str[i] != dequeue()) {
            isPalindrome = 0;
            break;
        }
    }

    if (isPalindrome)
        printf("Palindrome\n");
    else
        printf("Not Palindrome\n");

    return 0;
}
