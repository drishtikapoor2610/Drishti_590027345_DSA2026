#include <stdio.h>

#define MAX 100

char stackArr[MAX];
int topPos = -1;

void pushSymbol(char c) {
    stackArr[++topPos] = c;
}

void popSymbol() {
    topPos--;
}

int isMatching(char open, char close) {
    return (open == '(' && close == ')') ||
           (open == '{' && close == '}') ||
           (open == '[' && close == ']');
}

int main() {
    char expr[100];
    printf("Enter expression: ");
    scanf("%s", expr);

    for (int i = 0; expr[i] != '\0'; i++) {
        if (expr[i] == '(' || expr[i] == '{' || expr[i] == '[') {
            pushSymbol(expr[i]);
        } else {
            if (topPos == -1 || !isMatching(stackArr[topPos], expr[i])) {
                printf("Expression is NOT balanced");
                return 0;
            }
            popSymbol();
        }
    }

    if (topPos == -1)
        printf("Expression is balanced");
    else
        printf("Expression is NOT balanced");

    return 0;
}
